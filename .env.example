# Copy to .env:  cp .env.example .env
# Values below are for the LOCAL test stack only. Never put real platform credentials in this file.

# ---- service ----
SERVICE_NAME=longtail-network
ENVIRONMENT=local
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
# Empty = no auth (local). Set a long random value on the live demo; clients send "Authorization: Bearer <token>".
API_TOKEN=
RATE_LIMIT_PER_MINUTE=120

# ---- database (compose builds DATABASE_URL from these) ----
POSTGRES_USER=longtail
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_DB=longtail

# ---- jobs ----
# worker = separate worker container (compose) | inprocess = thread pool in API | sync = inline (tests)
JOB_EXECUTOR=worker
WORKER_POLL_INTERVAL_S=1.0
# Signs job callbacks: <CALLBACK_SIGNATURE_HEADER>: sha256=<hex HMAC of body>
CALLBACK_SIGNING_SECRET=local-only-callback-secret
# Header name carrying the signature; set it to the name your integration contract specifies
CALLBACK_SIGNATURE_HEADER=X-Signature
CALLBACK_TIMEOUT_S=5

# ---- storage (S3-compatible; SeaweedFS in compose) ----
STORAGE_BACKEND=s3
S3_BUCKET=longtail-network
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# Host-reachable endpoint used in download links
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
DOWNLOAD_URL_TTL_S=3600

# ---- connectors ----
# Kill switch, comma-separated connector keys, e.g. DISABLED_CONNECTORS=ghost,lemmy
DISABLED_CONNECTORS=
CONNECTOR_HTTP_TIMEOUT_S=10
# 429 waits up to this many seconds are done inline; longer ones return PLATFORM_RATE_LIMIT with retry time
MAX_INLINE_BACKOFF_S=10
MAX_RATE_LIMIT_RETRIES=2
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_S=60

# ---- simulation mode ----
# true = every destination is served by the mock platform server (no real accounts at all)
# false = local Ghost/Lemmy containers are used for real posts; other platforms use the mock server
SIMULATION_MODE=false

# ---- idempotency ----
IDEMPOTENCY_TTL_HOURS=72

# ---- posting rules and certification ----
# Domains that count as self-promotion when linked (comma-separated)
OWN_DOMAINS=
# Only certified destinations receive real posts
REQUIRE_CERTIFICATION=true
# Certification test posts must be deleted within this many seconds
CERTIFICATION_MAX_CLEANUP_S=600
# Optional: POST a JSON alert here when a destination is demoted
ALERT_WEBHOOK_URL=

# ---- AI provider (rules capture, relevance) ----
# mock = deterministic heuristics, no key, zero cost | anthropic = Claude (needs ANTHROPIC_API_KEY in the environment)
AI_PROVIDER=mock
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
AI_MAX_TOKENS=4000
# USD per million tokens, for cost reporting
AI_PRICE_INPUT_PER_MTOK=4.0
AI_PRICE_OUTPUT_PER_MTOK=20.0
# Server-side fallback model if the main model declines a request
AI_REFUSAL_FALLBACK=true

# ---- catalogue import and rules capture ----
CATALOGUE_CONCURRENCY=50
CATALOGUE_REACHABILITY_TIMEOUT_S=5
RULES_FETCH_MAX_BYTES=500000
CRAWLER_USER_AGENT=LongTailDestinationBot/1.0 (+catalogue rules check)
# SSRF guard: user-supplied URLs on private/loopback/single-label hosts are refused unless this is true.
# The local stack needs true (its mock platforms are internal hosts); keep false anywhere public.
ALLOW_INTERNAL_HOSTS=true

# ---- publishing ----
PUBLISH_RETRIES=2
# How the worker reaches this API, for live checks of pages we host (compose: http://api:8000)
INTERNAL_BASE_URL=
# Rights-cleared clip used to certify video destinations
CERTIFICATION_TEST_VIDEO_URL=https://example.com/certification-test.mp4

# ---- mock-backed demo destinations (local stack only) ----
MOCK_API_KEY=local-mock-key
PARTNER_WEBHOOK_SECRET=local-partner-secret

# ---- local test instances (test-only accounts on containers we own) ----
GHOST_ADMIN_EMAIL=bot@longtail.test
# Empty = a random owner password is generated on first run and kept in the app-secrets volume
GHOST_ADMIN_PASSWORD=
LEMMY_ADMIN_USERNAME=longtail_admin
LEMMY_ADMIN_PASSWORD=local-only-lemmy-pass-123
LEMMY_DB_PASSWORD=local-only-lemmy-db
LEMMY_COMMUNITY=longtail_test
